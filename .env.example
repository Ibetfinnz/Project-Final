# ===== Database =====
DB_USER=app
DB_PASS=change_me_db_password
DB_NAME=accounting

# ===== Backend =====
# สร้างค่าสุ่ม: PowerShell -> -join ((48..57)+(97..102)|Get-Random -Count 48|%{[char]$_})
#                bash       -> openssl rand -hex 24
JWT_SECRET=change_me_long_random_string
INTERNAL_API_KEY=change_me_internal_api_key
N8N_WEBHOOK_KEY=change_me_webhook_key

# URL ที่ backend ใช้เรียก webhook ของ workflow B (ต้องเป็นชื่อ service ใน compose)
N8N_UPLOAD_WEBHOOK=http://n8n:5678/webhook/ar-upload

# ===== SMTP (ส่งเอกสารให้ลูกค้า / แจ้งเตือน) =====
# Gmail ต้องเปิด 2-Step Verification แล้วสร้าง App Password 16 หลัก
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.account@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="บริษัทของคุณ <your.account@gmail.com>"

# ===== ข้อมูลบริษัทผู้ขาย (แสดงบนหัวเอกสาร PDF) =====
COMPANY_NAME=บริษัท เอไอ กรุ๊ป จำกัด
COMPANY_ADDRESS=99 ถนนตัวอย่าง แขวงตัวอย่าง เขตตัวอย่าง กรุงเทพฯ 10110
COMPANY_TAX_ID=0105000000000
BANK_INFO=ธนาคารกสิกรไทย 000-0-00000-0 ชื่อบัญชี บริษัท เอไอ กรุ๊ป จำกัด

# ===== n8n =====
N8N_ENCRYPTION_KEY=change_me_random_32_chars
N8N_HOST=localhost
N8N_PUBLIC_URL=http://localhost:5678/
